# CubeIDE build output (regenerated on build)
/Source/Debug/
*.o
*.d
*.su
*.cyclo
*.list
*.map
*.elf
*.bin
*.hex

# Slicer output (regenerated from the STL whenever it is needed)
# The STL is the source; a sliced file is that STL plus one printer's settings
# on one day, so committing it invites picking up a stale one later.
*.gx
*.gcode
*.3mf

# OS / editor cruft
.DS_Store
*~

# Editing backups (safety copies)
*.bak
*.bak-*
*.bak[0-9]

# Cowork scratch (redundant copies)
Claude outputs/

# Upstream reference (mazerunner-core, kept locally only)
Arduino Reference/

# Xcode / Swift (CompanionApp)
# Per-user state Xcode rewrites constantly - keeping it out means a diff only
# ever shows real changes, not which file you last had open.
xcuserdata/
*.xcuserstate
*.xcuserdatad/
DerivedData/
build/
.build/
*.xcarchive
*.ipa
*.dSYM
*.dSYM.zip
.swiftpm/
Package.resolved
